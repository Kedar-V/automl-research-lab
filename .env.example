# Copy to .env for local overrides. Never commit real secrets.

SERVICE_TOKEN=dev-service-token
HARNESS_TOKEN=dev-service-token

# Flip one at a time in Phase C as real services replace mocks.
MOCK_GATEWAY=true
MOCK_ORCHESTRATOR=true
MOCK_AGENT_SERVICE=true
MOCK_HARNESS=true
MOCK_DATASET_SERVICE=true
MOCK_MEMORY_SERVICE=true
MOCK_TRACKING_SERVICE=true

# Weights & Biases (optional). Logging uses the SDK; MCP is query/report only.
WANDB_ENABLED=false
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_PROJECT=automl-research-lab

# LLM provider for agent-service (Stage C5). Official path: Cursor Agent SDK.
LLM_PROVIDER=cursor
LLM_MODEL=composer-2.5
# CURSOR_API_KEY=

# Simple research loop (/simple-loop) — OpenRouter free model (never commit the real key).
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Airflow (Docker profile `--profile airflow` only — do not install Airflow on the host)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# AIRFLOW_FERNET_KEY=
