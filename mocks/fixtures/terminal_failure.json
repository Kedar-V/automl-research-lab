{
  "description": "SAMPLE FIXTURE — repair exhausted; trial marked failed; supervisor skips.",
  "mock": true,
  "steps": [
    {
      "delay_ms": 20,
      "type": "session_created",
      "source_service": "gateway",
      "source_agent": null,
      "payload": { "scenario": "terminal_failure", "note": "sample fixture session" }
    },
    {
      "delay_ms": 30,
      "type": "health",
      "source_service": "gateway",
      "source_agent": null,
      "payload": {
        "services": {
          "gateway": "ok",
          "orchestrator": "ok",
          "agent_service": "ok",
          "harness": "ok",
          "dataset_service": "ok",
          "memory_service": "ok",
          "tracking_service": "ok"
        }
      }
    },
    {
      "delay_ms": 40,
      "type": "agent_completed",
      "source_service": "orchestrator",
      "source_agent": "data_scientist",
      "payload": { "lead": "data_scientist", "status": "completed" }
    },
    {
      "delay_ms": 40,
      "type": "agent_completed",
      "source_service": "orchestrator",
      "source_agent": "hypothesis_generator",
      "payload": { "experiment_id": "e-1", "model_family": "xgboost" }
    },
    {
      "delay_ms": 40,
      "type": "agent_started",
      "source_service": "orchestrator",
      "source_agent": "ml_engineer",
      "payload": { "lead": "ml_engineer", "retry_count": 0 }
    },
    {
      "delay_ms": 40,
      "type": "trial_failed",
      "source_service": "harness",
      "source_agent": "experiment_runner",
      "payload": {
        "experiment_id": "e-1",
        "reason": "timeout",
        "timeout_status": "timed_out",
        "retry_count": 0,
        "note": "SAMPLE fixture timeout"
      }
    },
    {
      "delay_ms": 40,
      "type": "agent_started",
      "source_service": "orchestrator",
      "source_agent": "error_repair",
      "payload": { "subagent": "error_repair", "retry_count": 0 }
    },
    {
      "delay_ms": 40,
      "type": "agent_completed",
      "source_service": "orchestrator",
      "source_agent": "error_repair",
      "payload": { "subagent": "error_repair", "fix": { "n_estimators": 50 }, "retry_count": 1 }
    },
    {
      "delay_ms": 40,
      "type": "trial_failed",
      "source_service": "harness",
      "source_agent": "experiment_runner",
      "payload": {
        "experiment_id": "e-1",
        "reason": "timeout",
        "timeout_status": "timed_out",
        "retry_count": 1,
        "note": "SAMPLE: retries exhausted after one repair"
      }
    },
    {
      "delay_ms": 40,
      "type": "agent_completed",
      "source_service": "orchestrator",
      "source_agent": "ml_engineer",
      "payload": {
        "lead": "ml_engineer",
        "status": "failed",
        "retry_count": 1,
        "reason": "max_retries_exhausted"
      }
    },
    {
      "delay_ms": 40,
      "type": "activity",
      "source_service": "orchestrator",
      "source_agent": "meta_supervisor",
      "payload": { "message": "SAMPLE: supervisor skips failed trial e-1" }
    },
    {
      "delay_ms": 40,
      "type": "budget_update",
      "source_service": "orchestrator",
      "source_agent": "meta_supervisor",
      "payload": { "experiments_used": 1, "budget": 10, "failed_trials": 1 }
    },
    {
      "delay_ms": 40,
      "type": "agent_completed",
      "source_service": "orchestrator",
      "source_agent": "hypothesis_generator",
      "payload": { "experiment_id": "e-2", "model_family": "logistic_regression" }
    },
    {
      "delay_ms": 50,
      "type": "trial_completed",
      "source_service": "harness",
      "source_agent": "experiment_runner",
      "payload": {
        "experiment_id": "e-2",
        "note": "SAMPLE fixture metrics",
        "validation_metrics": { "f1": 0.45 }
      }
    },
    {
      "delay_ms": 40,
      "type": "verdict_issued",
      "source_service": "orchestrator",
      "source_agent": "judge",
      "payload": { "experiment_id": "e-2", "action": "accept" }
    },
    {
      "delay_ms": 40,
      "type": "holdout_evaluated",
      "source_service": "dataset_service",
      "source_agent": null,
      "payload": { "experiment_id": "e-2", "score": 0.42, "note": "SAMPLE fixture holdout" }
    },
    {
      "delay_ms": 30,
      "type": "stop_reason",
      "source_service": "orchestrator",
      "source_agent": "meta_supervisor",
      "payload": { "stop_reason": "accepted", "experiments_used": 2, "failed_trials": 1 }
    },
    {
      "delay_ms": 20,
      "type": "activity",
      "source_service": "gateway",
      "source_agent": null,
      "payload": { "message": "SAMPLE fixture scenario 'terminal_failure' complete", "done": true }
    }
